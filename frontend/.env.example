# URL du backend FastAPI en production (ex: Render)
# En local, laissez vide pour utiliser le proxy Vite (http://localhost:8000)
VITE_API_URL=https://votre-backend.onrender.com

# Client ID Google OAuth (Google Cloud Console > API & Services > Identifiants)
VITE_GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com

